# Copy this file to .env.local for local work. In Vercel, add the same names under
# Project Settings > Environment Variables. Never commit real values.
# Names starting NEXT_PUBLIC_ are built into the pages, so redeploy after changing them.

# --- Required before launch ---------------------------------------------------

# The live address of this website, with no trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.earnbuildprotect.com

# The address of the existing Financial Resilience Check application.
# While this is empty, every Check button shows a labelled configuration placeholder.
# Planned address: https://app.earnbuildprotect.com (set it once the subdomain is live and confirmed).
NEXT_PUBLIC_ASSESSMENT_URL=

# Leave unset until launch is approved. Set to true on the production environment only.
# While unset, robots.txt asks search engines not to index the site.
NEXT_PUBLIC_ALLOW_INDEXING=

# --- Contact form (Resend) ----------------------------------------------------
# While any of these three is empty, the form tells the sender their message was not sent.
RESEND_API_KEY=
# Inbox that receives enquiries.
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, for example: Earn.Build.Protect <website@earnbuildprotect.com>
CONTACT_FROM_EMAIL=

# --- Spam protection (Cloudflare Turnstile, optional but recommended) ---------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics ----------------------------------------------------------------
# Vercel Web Analytics needs no variable: enable it in the Vercel dashboard.
# Optional alternative or addition: Plausible. Enter the bare domain, for example earnbuildprotect.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Content editor in production (Keystatic GitHub mode, optional) -----------
# Leave all five empty to keep the editor available on your own machine only.
# Format: owner/repository
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
